{
  "name": "comate",
  "version": "0.1.1",
  "description": "个人刷题笔记（数据仅本机使用）",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron-vite dev",
    "build": "set ELECTRON_RUN_AS_NODE=&& electron-vite build",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron-vite preview",
    "dist": "electron-builder --publish always",
    "dist:dir": "electron-builder --dir",
    "test": "node --test test/*.test.cjs"
  },
  "build": {
    "appId": "com.tage.app",
    "productName": "题迹",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "bugsong",
      "repo": "electron-tage",
      "private": false,
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "better-sqlite3": "^13.0.3",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.9",
    "pinia": "^4.0.3",
    "sharp": "^0.35.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^8.2.2"
  }
}
